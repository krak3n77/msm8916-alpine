# OctoPrint appliance profile
OCTOPRINT_PREINSTALL="yes"
USB_GADGET_INSTALL="no"   # USB port used for printer; do not install gadget tooling
USB_GADGET_ENABLED="no"   # USB port used for printer; gadget networking not needed at boot
USB_GADGET_OTG="yes"      # Boot in OTG host mode so printer enumerates immediately
