#!/bin/bash
# nm-wrapper.check: self-check for nm-wrapper.
# Works with or without a real NetworkManager (stubs nmcli when absent).
# Usage: bash nm-wrapper.check [/path/to/nm-wrapper]
# Exit 0 = all checks passed, 1 = failures.
set -euo pipefail

WRAPPER="${1:-/usr/local/sbin/nm-wrapper}"
PASS=0; FAIL=0

ok()   { echo "  PASS: $*"; PASS=$((PASS+1)); }
fail() { echo "  FAIL: $*"; FAIL=$((FAIL+1)); }

is_json() { echo "$1" | grep -qE '^\{.*\}$'; }

check_json() {
    local out="$1" label="$2"
    is_json "$out" && ok "$label" || fail "$label (not JSON: $out)"
}

echo "=== nm-wrapper self-check ==="
echo "    wrapper: $WRAPPER"

# ── 1. syntax ───────────────────────────────────────────────────────────────
bash -n "$WRAPPER" 2>/dev/null \
    && ok "syntax check" || fail "syntax check"

# ── 2. unknown command exits non-zero ────────────────────────────────────────
"$WRAPPER" bogus >/dev/null 2>&1 && fail "unknown command should exit non-zero" \
    || ok "unknown command exits non-zero"

# ── 3. no-args exits non-zero ────────────────────────────────────────────────
"$WRAPPER" >/dev/null 2>&1 && fail "no-args should exit non-zero" \
    || ok "no-args exits non-zero"

# ── 4. live checks (nmcli present) or stub checks ────────────────────────────
if command -v nmcli >/dev/null 2>&1; then
    echo "  [nmcli found — live checks]"

    OUT=$("$WRAPPER" status 2>/dev/null); RC=$?
    [ $RC -eq 0 ] && ok "status exits 0" || fail "status exited $RC"
    check_json "$OUT" "status returns JSON"
    echo "$OUT" | grep -q '"interface"'  && ok "status.interface present"  || fail "status missing 'interface'"
    echo "$OUT" | grep -q '"state"'      && ok "status.state present"      || fail "status missing 'state'"
    echo "$OUT" | grep -q '"connection"' && ok "status.connection present"  || fail "status missing 'connection'"

    OUT=$("$WRAPPER" read 2>/dev/null); RC=$?
    check_json "$OUT" "read returns JSON"
    if [ $RC -eq 0 ]; then
        echo "$OUT" | grep -q '"ssid"'        && ok "read.ssid present"        || fail "read missing 'ssid'"
        echo "$OUT" | grep -q '"ipv4_method"' && ok "read.ipv4_method present" || fail "read missing 'ipv4_method'"
        echo "$OUT" | grep -q '"address"'     && ok "read.address present"     || fail "read missing 'address'"
        echo "$OUT" | grep -q '"gateway"'     && ok "read.gateway present"     || fail "read missing 'gateway'"
        echo "$OUT" | grep -q '"dns"'         && ok "read.dns present"         || fail "read missing 'dns'"
    else
        echo "  [read returned error — no active wlan0 connection, checking error JSON]"
        echo "$OUT" | grep -q '"error"' && ok "error response has 'error' key" || fail "error response missing 'error'"
    fi

else
    echo "  [nmcli not found — stub checks]"

    # Build a stub nmcli in a temp dir.
    TMPCK=$(mktemp -d)
    trap 'rm -rf "$TMPCK"' EXIT

    cat > "$TMPCK/nmcli" <<'STUB'
#!/bin/sh
# Stub nmcli — matches the exact call patterns used by nm-wrapper.
case "$*" in
    *DEVICE,STATE*)                          echo "wlan0:connected"; echo "lo:unmanaged" ;;
    *GENERAL.CONNECTION*device*show*wlan0*)  echo "TestSSID" ;;
    *802-11-wireless.ssid*connection*show*)  echo "TestSSID" ;;
    *ipv4.method*connection*show*)           echo "auto" ;;
    *IP4.ADDRESS*device*show*wlan0*)         echo "192.168.1.100/24" ;;
    *IP4.GATEWAY*device*show*wlan0*)         echo "192.168.1.1" ;;
    *IP4.DNS*device*show*wlan0*)             printf "8.8.8.8\n8.8.4.4\n" ;;
    *NAME,DEVICE*connection*show*)           echo "wlan0:wlan0" ;;
    *connection*reload*)                     exit 0 ;;
    *connection*up*)                         exit 0 ;;
    *connection*modify*)                     exit 0 ;;
    *connection*add*)                        exit 0 ;;
    *)                                       echo "stub: unhandled args: $*" >&2; exit 1 ;;
esac
STUB
    chmod +x "$TMPCK/nmcli"

    # Run wrapper with stub nmcli injected via PATH.
    OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" status 2>/dev/null); RC=$?
    [ $RC -eq 0 ] && ok "status exits 0 (stub)" || fail "status exited $RC (stub)"
    check_json "$OUT" "status returns JSON (stub)"
    echo "$OUT" | grep -q '"interface":"wlan0"'    && ok "status.interface=wlan0"   || fail "status.interface wrong: $OUT"
    echo "$OUT" | grep -q '"state":"connected"'    && ok "status.state=connected"   || fail "status.state wrong: $OUT"
    echo "$OUT" | grep -q '"connection":"TestSSID"' && ok "status.connection=TestSSID" || fail "status.connection wrong: $OUT"

    OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" read 2>/dev/null); RC=$?
    [ $RC -eq 0 ] && ok "read exits 0 (stub)" || fail "read exited $RC (stub)"
    check_json "$OUT" "read returns JSON (stub)"
    echo "$OUT" | grep -q '"ssid":"TestSSID"'       && ok "read.ssid=TestSSID"       || fail "read.ssid wrong: $OUT"
    echo "$OUT" | grep -q '"ipv4_method":"auto"'    && ok "read.ipv4_method=auto"    || fail "read.ipv4_method wrong: $OUT"
    echo "$OUT" | grep -q '"address":"192.168.'     && ok "read.address present"     || fail "read.address wrong: $OUT"
    echo "$OUT" | grep -q '"gateway":"192.168.1.1"' && ok "read.gateway correct"     || fail "read.gateway wrong: $OUT"
    echo "$OUT" | grep -q '"dns":"8.8.8.8'          && ok "read.dns has first entry" || fail "read.dns wrong: $OUT"

    # ── save-wifi-dhcp stub checks ──────────────────────────────────────────
    echo ""
    echo "  [save-wifi-dhcp stub checks]"

    # ponytail: use RC=0; OUT=$(...)|| RC=$? to avoid set -e firing on expected non-zero exits.

    # Valid SSID + valid password → ok:true
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "MyNetwork" "password123" 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "save-wifi-dhcp exits 0 (valid)" || fail "save-wifi-dhcp exited $RC (valid)"
    check_json "$OUT" "save-wifi-dhcp returns JSON (valid)"
    echo "$OUT" | grep -q '"ok":true'            && ok "save-wifi-dhcp.ok=true"           || fail "save-wifi-dhcp.ok wrong: $OUT"
    echo "$OUT" | grep -q '"ssid":"MyNetwork"'   && ok "save-wifi-dhcp.ssid=MyNetwork"    || fail "save-wifi-dhcp.ssid wrong: $OUT"
    echo "$OUT" | grep -q '"ipv4_method":"auto"' && ok "save-wifi-dhcp.ipv4_method=auto"  || fail "save-wifi-dhcp.ipv4_method wrong: $OUT"

    # 64-char hex raw PSK → ok
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "MyNetwork" \
        "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2" 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "save-wifi-dhcp 64-char hex PSK exits 0" || fail "save-wifi-dhcp 64-char hex PSK exited $RC"

    # Missing SSID → error, exit 1
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "" "password123" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-dhcp empty SSID exits non-zero" || fail "save-wifi-dhcp empty SSID should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "save-wifi-dhcp empty SSID returns error JSON" || fail "save-wifi-dhcp empty SSID missing error key: $OUT"

    # SSID > 32 chars → error
    LONG_SSID="ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567"
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "$LONG_SSID" "password123" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-dhcp long SSID exits non-zero" || fail "save-wifi-dhcp long SSID should exit non-zero"

    # Password too short → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "MyNetwork" "short" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-dhcp short password exits non-zero" || fail "save-wifi-dhcp short password should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "save-wifi-dhcp short password returns error JSON" || fail "save-wifi-dhcp short password missing error key: $OUT"

    # Password too long (65 non-hex chars) → error
    LONG_PASS="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "MyNetwork" "$LONG_PASS" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-dhcp long password exits non-zero" || fail "save-wifi-dhcp long password should exit non-zero"

    # 64-char non-hex → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-dhcp "MyNetwork" \
        "ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-dhcp 64-char non-hex exits non-zero" || fail "save-wifi-dhcp 64-char non-hex should exit non-zero"

    # ── save-wifi-static stub checks ────────────────────────────────────────
    echo ""
    echo "  [save-wifi-static stub checks]"

    # Valid args → ok:true, ipv4_method=manual
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/24" "192.168.1.1" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "save-wifi-static exits 0 (valid)" || fail "save-wifi-static exited $RC (valid)"
    check_json "$OUT" "save-wifi-static returns JSON (valid)"
    echo "$OUT" | grep -q '"ok":true'               && ok "save-wifi-static.ok=true"              || fail "save-wifi-static.ok wrong: $OUT"
    echo "$OUT" | grep -q '"ssid":"MyNetwork"'      && ok "save-wifi-static.ssid=MyNetwork"       || fail "save-wifi-static.ssid wrong: $OUT"
    echo "$OUT" | grep -q '"ipv4_method":"manual"'  && ok "save-wifi-static.ipv4_method=manual"   || fail "save-wifi-static.ipv4_method wrong: $OUT"

    # Valid with comma-separated DNS
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "10.0.0.5/8" "10.0.0.1" "8.8.8.8,8.8.4.4" 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "save-wifi-static multi-DNS exits 0" || fail "save-wifi-static multi-DNS exited $RC"

    # Missing CIDR prefix (no slash) → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100" "192.168.1.1" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static no-slash CIDR exits non-zero" || fail "save-wifi-static no-slash CIDR should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "save-wifi-static no-slash CIDR returns error JSON" || fail "save-wifi-static no-slash CIDR missing error key: $OUT"

    # Invalid CIDR prefix (> 32) → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/33" "192.168.1.1" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static prefix>32 exits non-zero" || fail "save-wifi-static prefix>32 should exit non-zero"

    # Invalid CIDR prefix (0) → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/0" "192.168.1.1" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static prefix=0 exits non-zero" || fail "save-wifi-static prefix=0 should exit non-zero"

    # Invalid address octets → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "999.1.1.1/24" "192.168.1.1" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static bad address octet exits non-zero" || fail "save-wifi-static bad address octet should exit non-zero"

    # Invalid gateway → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/24" "not-an-ip" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static bad gateway exits non-zero" || fail "save-wifi-static bad gateway should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "save-wifi-static bad gateway returns error JSON" || fail "save-wifi-static bad gateway missing error key: $OUT"

    # Invalid gateway octets → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/24" "256.0.0.1" "8.8.8.8" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static gateway octet>255 exits non-zero" || fail "save-wifi-static gateway octet>255 should exit non-zero"

    # Invalid DNS entry → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/24" "192.168.1.1" "notadns" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static bad DNS exits non-zero" || fail "save-wifi-static bad DNS should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "save-wifi-static bad DNS returns error JSON" || fail "save-wifi-static bad DNS missing error key: $OUT"

    # Invalid second DNS entry in comma list → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/24" "192.168.1.1" "8.8.8.8,bad" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static bad second DNS exits non-zero" || fail "save-wifi-static bad second DNS should exit non-zero"

    # Missing DNS → error
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" save-wifi-static \
        "MyNetwork" "password123" "192.168.1.100/24" "192.168.1.1" "" 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "save-wifi-static empty DNS exits non-zero" || fail "save-wifi-static empty DNS should exit non-zero"

    # ── apply-wifi stub checks ──────────────────────────────────────────────
    echo ""
    echo "  [apply-wifi stub checks]"

    # Valid → ok:true, interface=wlan0, connection present
    RC=0; OUT=$(PATH="$TMPCK:$PATH" "$WRAPPER" apply-wifi 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "apply-wifi exits 0 (stub)" || fail "apply-wifi exited $RC (stub)"
    check_json "$OUT" "apply-wifi returns JSON (stub)"
    echo "$OUT" | grep -q '"ok":true'              && ok "apply-wifi.ok=true"           || fail "apply-wifi.ok wrong: $OUT"
    echo "$OUT" | grep -q '"interface":"wlan0"'    && ok "apply-wifi.interface=wlan0"   || fail "apply-wifi.interface wrong: $OUT"
    echo "$OUT" | grep -q '"connection":"'          && ok "apply-wifi.connection present" || fail "apply-wifi.connection wrong: $OUT"

    # ── backup-wifi stub checks ─────────────────────────────────────────────
    echo ""
    echo "  [backup-wifi stub checks]"

    # Temp dirs for NM_CONN_DIR and BACKUP_DIR so we don't touch real system paths.
    TMPNM=$(mktemp -d)
    TMPBK=$(mktemp -d)
    trap 'rm -rf "$TMPCK" "$TMPNM" "$TMPBK"' EXIT

    # Stub nmcli returns "TestSSID" as the connection; seed the NM_CONN_DIR.
    printf '[connection]\nid=TestSSID\n[wifi-security]\npsk=secret\n' \
        > "$TMPNM/TestSSID.nmconnection"
    chmod 0600 "$TMPNM/TestSSID.nmconnection"

    # Valid backup → ok:true, backup path in output.
    RC=0; OUT=$(NM_CONN_DIR="$TMPNM" BACKUP_DIR="$TMPBK" PATH="$TMPCK:$PATH" \
        "$WRAPPER" backup-wifi 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "backup-wifi exits 0 (stub)" || fail "backup-wifi exited $RC (stub)"
    check_json "$OUT" "backup-wifi returns JSON (stub)"
    echo "$OUT" | grep -q '"ok":true'   && ok "backup-wifi.ok=true"       || fail "backup-wifi.ok wrong: $OUT"
    echo "$OUT" | grep -q '"backup":"'  && ok "backup-wifi.backup present" || fail "backup-wifi.backup missing: $OUT"

    # Backup file must exist and be mode 0600 (no group/other read — secrets safe).
    BFILE=$(ls "$TMPBK/"*.nmconnection 2>/dev/null | head -1) || BFILE=""
    [ -n "$BFILE" ] && ok "backup file created" || fail "backup file not found in $TMPBK"
    if [ -n "$BFILE" ]; then
        # ponytail: cut to 10 chars — macOS ls appends @ for xattrs, Linux does not.
        PERMS=$(ls -l "$BFILE" | awk '{print $1}' | cut -c1-10)
        [ "$PERMS" = "-rw-------" ] && ok "backup file is mode 0600" \
            || fail "backup file permissions wrong: $PERMS (want -rw-------)"
    fi

    # No connection profile available → error JSON + non-zero exit.
    cat > "$TMPCK/nmcli" <<'STUB2'
#!/bin/sh
case "$*" in
    *GENERAL.CONNECTION*device*show*) echo "--" ;;
    *NAME,DEVICE*connection*show*)   echo "" ;;
    *) echo "stub2: unhandled: $*" >&2; exit 1 ;;
esac
STUB2
    chmod +x "$TMPCK/nmcli"
    RC=0; OUT=$(NM_CONN_DIR="$TMPNM" BACKUP_DIR="$TMPBK" PATH="$TMPCK:$PATH" \
        "$WRAPPER" backup-wifi 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "backup-wifi no-conn exits non-zero" \
        || fail "backup-wifi no-conn should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "backup-wifi no-conn returns error JSON" \
        || fail "backup-wifi no-conn missing error key: $OUT"

    # Restore stub nmcli to standard stub.
    cat > "$TMPCK/nmcli" <<'STUB'
#!/bin/sh
case "$*" in
    *DEVICE,STATE*)                          echo "wlan0:connected"; echo "lo:unmanaged" ;;
    *GENERAL.CONNECTION*device*show*wlan0*)  echo "TestSSID" ;;
    *802-11-wireless.ssid*connection*show*)  echo "TestSSID" ;;
    *ipv4.method*connection*show*)           echo "auto" ;;
    *IP4.ADDRESS*device*show*wlan0*)         echo "192.168.1.100/24" ;;
    *IP4.GATEWAY*device*show*wlan0*)         echo "192.168.1.1" ;;
    *IP4.DNS*device*show*wlan0*)             printf "8.8.8.8\n8.8.4.4\n" ;;
    *NAME,DEVICE*connection*show*)           echo "TestSSID:wlan0" ;;
    *connection*reload*)                     exit 0 ;;
    *connection*up*)                         exit 0 ;;
    *connection*modify*)                     exit 0 ;;
    *connection*add*)                        exit 0 ;;
    *)                                       echo "stub: unhandled args: $*" >&2; exit 1 ;;
esac
STUB
    chmod +x "$TMPCK/nmcli"

    # ── restore-wifi stub checks ─────────────────────────────────────────────
    echo ""
    echo "  [restore-wifi stub checks]"

    # Valid restore (uses the backup created above) → ok:true.
    RC=0; OUT=$(NM_CONN_DIR="$TMPNM" BACKUP_DIR="$TMPBK" PATH="$TMPCK:$PATH" \
        "$WRAPPER" restore-wifi 2>/dev/null) || RC=$?
    [ $RC -eq 0 ] && ok "restore-wifi exits 0 (stub)" || fail "restore-wifi exited $RC (stub)"
    check_json "$OUT" "restore-wifi returns JSON (stub)"
    echo "$OUT" | grep -q '"ok":true'           && ok "restore-wifi.ok=true"           || fail "restore-wifi.ok wrong: $OUT"
    echo "$OUT" | grep -q '"restored":"'         && ok "restore-wifi.restored present"  || fail "restore-wifi.restored missing: $OUT"
    echo "$OUT" | grep -q '"interface":"wlan0"'  && ok "restore-wifi.interface=wlan0"  || fail "restore-wifi.interface wrong: $OUT"
    echo "$OUT" | grep -q '"connection":"'        && ok "restore-wifi.connection present" || fail "restore-wifi.connection missing: $OUT"

    # Restored connection file must be mode 0600.
    if [ -f "$TMPNM/TestSSID.nmconnection" ]; then
        # ponytail: cut to 10 chars — macOS ls appends @ for xattrs, Linux does not.
        PERMS=$(ls -l "$TMPNM/TestSSID.nmconnection" | awk '{print $1}' | cut -c1-10)
        [ "$PERMS" = "-rw-------" ] && ok "restored file is mode 0600" \
            || fail "restored file permissions wrong: $PERMS (want -rw-------)"
    fi

    # No backup dir → error JSON + non-zero exit.
    TMPBK2=$(mktemp -d) && rm -rf "$TMPBK2"  # ensure it does not exist
    RC=0; OUT=$(NM_CONN_DIR="$TMPNM" BACKUP_DIR="$TMPBK2" PATH="$TMPCK:$PATH" \
        "$WRAPPER" restore-wifi 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "restore-wifi no-dir exits non-zero" \
        || fail "restore-wifi no-dir should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "restore-wifi no-dir returns error JSON" \
        || fail "restore-wifi no-dir missing error key: $OUT"

    # Empty backup dir → error JSON + non-zero exit.
    TMPBK3=$(mktemp -d)
    RC=0; OUT=$(NM_CONN_DIR="$TMPNM" BACKUP_DIR="$TMPBK3" PATH="$TMPCK:$PATH" \
        "$WRAPPER" restore-wifi 2>/dev/null) || RC=$?
    [ $RC -ne 0 ] && ok "restore-wifi empty-dir exits non-zero" \
        || fail "restore-wifi empty-dir should exit non-zero"
    echo "$OUT" | grep -q '"error"' && ok "restore-wifi empty-dir returns error JSON" \
        || fail "restore-wifi empty-dir missing error key: $OUT"
    rm -rf "$TMPBK3"
fi

echo ""
echo "=== Results: $PASS passed, $FAIL failed ==="
[ "$FAIL" -eq 0 ] && exit 0 || exit 1
