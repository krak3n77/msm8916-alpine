# USB serial printer drivers (issue-003)
# Enables CH340/CH341, CDC ACM, FTDI, and PL2303 as loadable modules so
# OctoPrint can communicate with Creality and similar USB-serial printers.
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
