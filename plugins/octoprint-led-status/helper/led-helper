#!/bin/sh
# ponytail: only idle/disconnected states, only green:wan and blue:wlan
# Never writes to red:power.

GREEN=/sys/class/leds/green:wan
BLUE=/sys/class/leds/blue:wlan

led_solid() {
    # Args: <led-path> <brightness 0-255>
    [ -d "$1" ] || return 0
    printf 'none' > "$1/trigger"  2>/dev/null || return 0
    printf '%s'   "$2" > "$1/brightness" 2>/dev/null || true
}

led_blink() {
    # Args: <led-path>  — fast 100ms blink via kernel timer trigger
    [ -d "$1" ] || return 0
    printf 'timer' > "$1/trigger" 2>/dev/null || return 0
    printf '100'   > "$1/delay_on"  2>/dev/null || true
    printf '100'   > "$1/delay_off" 2>/dev/null || true
}

case "$1" in
    idle)
        led_solid "$GREEN" 255
        led_solid "$BLUE"  0
        ;;
    disconnected)
        led_solid "$GREEN" 0
        led_blink "$BLUE"
        ;;
    *)
        printf 'Usage: %s {idle|disconnected}\n' "$0" >&2
        exit 1
        ;;
esac
